# Variáveis de Ambiente
# O Firebase está configurado com chaves hardcoded no código
# Não é necessário configurar variáveis do Firebase aqui

# Chave de criptografia (OBRIGATÓRIA)
# Use uma chave forte e única (mínimo 32 caracteres recomendado)
VITE_ENCRYPTION_KEY=your-secret-encryption-key-here-change-this-in-production

# Para desabilitar o Firebase, descomente a linha abaixo (não recomendado)
# VITE_FIREBASE_DISABLED=true
